<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".CounterScreen">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="38"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#15152A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvPlayer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:text="Player"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Score"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/throw1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/throw2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/throw3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="24sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/undoBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_next"
                    android:text="Undo"
                    android:textColor="@color/white"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/enterBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_next"
                    android:text="Enter"
                    android:textColor="@color/white"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/nextBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_next"
                    android:enabled="false"
                    android:text="Next"
                    android:textColor="@color/white"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <ToggleButton
            android:id="@+id/toggleDouble"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textOn="Double"
            android:textOff="Double"
            android:background="@drawable/btn_toggle" />

        <ToggleButton
            android:id="@+id/toggleTriple"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textOn="Triple"
            android:textOff="Triple"
            android:background="@drawable/btn_toggle" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="53"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/input1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/input2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/input3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#15152A"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/input4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/input5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/input6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#15152A"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/input7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/input8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/input9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#15152A"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/inputC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="C"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/input0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#15152A"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />

            <Button
                android:id="@+id/inputB"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#15152A"
                android:text="B"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                app:cornerRadius="5sp"
                app:toggleCheckedStateOnClick="true" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>